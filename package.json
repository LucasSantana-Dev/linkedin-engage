    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --verbose --coverage --coverageReporters=text-summary",
    "install-hooks": "sh scripts/install-hooks.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
